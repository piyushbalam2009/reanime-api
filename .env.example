APP_NAME=ReAnime API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
REDIS_URL=

SOURCE_BASE_URL=https://reanime.cz
SOURCE_TIMEOUT_SECONDS=20
SOURCE_ACCESS_MODE=direct

# FlareSolverr must be reachable by the API. Keep it bound to localhost.
FLIXCLOUD_FLARESOLVERR_URL=http://127.0.0.1:8191
FLIXCLOUD_FLARESOLVERR_TIMEOUT_SECONDS=60000
